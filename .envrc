# Configuration direnv pour Pexiora TT
source_up_if_exists
watch_file package.json
watch_file mise.toml
watch_file lefthook.yml

# --- Outils gérés par mise (Zola, just, bats, node, bun, pnpm) ---

if has mise; then
  eval "$(mise env bash)"
else
  echo "❌ mise n'est pas installé. Installez-le avec:"
  echo "   - brew install mise"
  echo "   Puis redémarrez votre shell"
  return 1
fi

# --- Dépendances js (pnpm/Bun) ---

# Vérification et installation des dépendances js avec pnpm
if [ -f "package.json" ]; then
    echo "Vérification et installation des dépendances avec pnpm..."
    pnpm install --silent
    # Installer les hooks lefthook
    if has bun; then
        echo "Installation des hooks lefthook..."
        bun run prepare 2>/dev/null || lefthook install
    fi
fi

# Mettre à disposition les exécutables locaux (comme netlify-cli)
# Ajoute ./node_modules/.bin au PATH
layout node

# Template de message de commit (voir commitlint.config.js pour les types autorisés)
git config commit.template .gitmessage

# --- Vérifications des Outils Systèmes ---

has zola || echo "❌ Zola n'est pas installé (géré par mise, relancez 'direnv reload')."
has just || echo "❌ just n'est pas installé (géré par mise, relancez 'direnv reload')."
has bats || echo "❌ bats n'est pas installé (géré par mise, relancez 'direnv reload')."
has bun || echo "❌ Bun n'est pas installé (géré par mise, relancez 'direnv reload')."

# --- Finalisation et Messages ---

echo "✅ Environnement Pexiora TT prêt !"
echo "💡 Commandes disponibles :"
echo "   just dev    - Démarrer le serveur de développement"
echo "   just build  - Construire le site"
echo "   just check  - Vérifier la qualité du code"
echo "   just test   - Lancer les tests"

# Vérifier les versions
echo ""
echo "🔧 Versions installées :"
echo "   Zola: $(zola --version)"
echo "   pnpm: $(pnpm --version 2>/dev/null || echo "Non installé")"
echo "   Netlify CLI: $(pnpm exec netlify --version 2>/dev/null || echo "Non installé")"
echo "   Bun: $(bun --version 2>/dev/null || echo "Non installé")"
echo "   Just: $(just --version 2>/dev/null || echo "Non installé")"
